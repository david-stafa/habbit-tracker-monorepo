{
    "$schema": "https://turborepo.com/schema.json",
    "tasks": {
      "build": {
        "dependsOn": ["^build"],
        "outputs": ["dist/**", "build/**"],
        "inputs": ["src/**", "package.json", "tsconfig.json"]
      },
      "dev": {
        "cache": false,
        "persistent": true
      },
      "lint": {
        "dependsOn": ["^lint"],
        "outputs": []  
      },
      "check-types": {
        "dependsOn": ["^check-types"]
      },
      "format": {
        "dependsOn": ["^format"]
      },
      "format:check": {
        "dependsOn": ["^format:check"]
      }
    }
  }