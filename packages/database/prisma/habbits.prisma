model Habbit {
  id              String           @id @default(cuid())
  name            String
  description     String?
  points          Int              @default(1)
  habbitInstances HabbitInstance[]
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("habbit")
}

model HabbitInstance {
  id        String   @id @default(cuid())
  date      DateTime
  points    Int      @default(1)
  completed Boolean  @default(false)
  habbitId  String
  habbit    Habbit   @relation(fields: [habbitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@map("habbitInstance")
}

model MonthlyRewards {
  id        String   @id @default(cuid())
  points    Int      @default(0)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("weeklyRewards")
}
